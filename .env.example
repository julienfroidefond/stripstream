# Stripstream environment variables
# Copy to .env and adjust: cp .env.example .env

# ---------------------------------------------------------------------------
# Required (read by app code)
# ---------------------------------------------------------------------------

# SQLite database used by Prisma (see prisma/schema.prisma).
# Prisma 7 resolves a relative `file:` path from the process working directory
# (project root), i.e. prisma/data/stripstream.db.
DATABASE_URL=file:./prisma/data/stripstream.db

# MANDATORY. NextAuth session/JWT encryption key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public base URL of this app (used by NextAuth for callbacks).
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Strongly recommended (read by app code)
# ---------------------------------------------------------------------------

# Encrypts provider credentials at rest (Komga password, Stripstream token):
# AES-256-GCM, 32 bytes in base64 or 64 hex characters.
# Generate with: openssl rand -base64 32
# Without it, credentials are stored in plaintext and a warning is logged on
# every write. Set it before saving connections, or migrate existing rows once
# with `pnpm encrypt-credentials` (idempotent). Mandatory with docker-compose.yml.
# CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional app flags (read by app code)
# ---------------------------------------------------------------------------

# "development" | "production" | "test" (defaults to development).
# NODE_ENV=production

# Password for the admin account created by scripts/init-db.ts on first boot.
# No default: if the admin account is missing and this is empty (or shorter
# than 8 characters), the account is NOT created (the app still starts). An
# existing account is never modified. Runtime variable only, never a build arg.
# ADMIN_DEFAULT_PASSWORD=

# Self-service sign-up. Closed unless set to "true" (behaviour change: sign-up
# used to be always open).
# REGISTRATION_ENABLED=false

# Debug logging toggles (1/true to enable).
# CACHE_DEBUG=false
# KOMGA_DEBUG=false
# STRIPSTREAM_DEBUG=false

# Rate-limit counter store: "sqlite" (default) persists windows in the
# rate_limit_buckets table; "memory" keeps them in the process (reset on
# restart, not shared between instances).
# RATE_LIMIT_STORE=sqlite

# Next.js build directory (defaults to .next; the E2E suite uses .next-e2e).
# NEXT_DIST_DIR=.next

# Reverse proxies trusted in front of the app (client IP for the per-IP
# sign-in/sign-up budgets). Set to 1 behind a single nginx/Traefik/Caddy that
# appends to X-Forwarded-For; see ENV.md "Reverse proxy et rate limiting".
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Compose-only / currently unused by the app
# Set by docker-compose.yml; not read directly by app code.
# ---------------------------------------------------------------------------

# AUTH_TRUST_HOST=true
# KOMGA_MAX_CONCURRENT_REQUESTS=5
# PRISMA_DATA_PATH=./prisma/data
