# Stripstream environment variables
# Copy to .env and adjust: cp .env.example .env

# ---------------------------------------------------------------------------
# Required (read by app code)
# ---------------------------------------------------------------------------

# SQLite database used by Prisma (see prisma/schema.prisma).
# Relative path is resolved from the prisma/ directory (schema location), i.e. prisma/data/stripstream.db.
DATABASE_URL=file:./data/stripstream.db

# MANDATORY. NextAuth session/JWT encryption key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public base URL of this app (used by NextAuth for callbacks).
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional app flags (read by app code)
# ---------------------------------------------------------------------------

# "development" | "production" | "test" (defaults to development).
# NODE_ENV=production

# Password for the admin account created by scripts/init-db.mjs
# (and used at build time by docker-compose).
# ADMIN_DEFAULT_PASSWORD=Admin@2025

# Debug logging toggles (1/true to enable).
# CACHE_DEBUG=false
# KOMGA_DEBUG=false
# STRIPSTREAM_DEBUG=false

# Stripstream Librarian fallback, used when the user has not saved a
# URL/token in the database.
# STRIPSTREAM_URL=https://librarian.example.com
# STRIPSTREAM_TOKEN=stl_xxxx_xxxxxxxx

# ---------------------------------------------------------------------------
# Compose-only / currently unused by the app
# Set by docker-compose.yml; not read directly by app code.
# ---------------------------------------------------------------------------

# AUTH_TRUST_HOST=true
# KOMGA_MAX_CONCURRENT_REQUESTS=5
# PRISMA_DATA_PATH=./prisma/data
