// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int      @id @default(autoincrement())
  email                     String   @unique
  password                  String
  roles                     Json     @default("[\"ROLE_USER\"]")
  authenticated             Boolean  @default(true)
  activeProvider            String?
  activeKomgaConfigId       Int?
  activeStripstreamConfigId Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  komgaConfigs       KomgaConfig[]
  stripstreamConfigs StripstreamConfig[]
  preferences        Preferences?
  favorites          Favorite[]
  readProgresses     ReadProgress[]

  @@map("users")
}

model KomgaConfig {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  url        String
  username   String
  authHeader String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@unique([userId, name])
  @@index([userId])
  @@map("komgaconfigs")
}

model StripstreamConfig {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  url       String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@unique([userId, name])
  @@index([userId])
  @@map("stripstreamconfigs")
}

model Preferences {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  showThumbnails       Boolean  @default(true)
  showOnlyUnread       Boolean  @default(false)
  displayMode          Json
  background           Json
  readerPrefetchCount  Int      @default(5)
  anonymousMode        Boolean  @default(false)
  readingDirection     String   @default("ltr")
  readerFitMode        String   @default("fit")
  readerDoublePageMode Boolean  @default(false)
  defaultSortOrder     String   @default("title")
  showMissingBooks     Boolean  @default(true)
  hideMissingBooks     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Favorite {
  id                  Int      @id @default(autoincrement())
  userId              Int
  seriesId            String
  provider            String   @default("komga")
  komgaConfigId       Int?
  stripstreamConfigId Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  komgaConfig       KomgaConfig?       @relation(fields: [komgaConfigId], references: [id], onDelete: Cascade)
  stripstreamConfig StripstreamConfig? @relation(fields: [stripstreamConfigId], references: [id], onDelete: Cascade)

  // Une série ne peut être favorite qu'une seule fois par config (par type).
  // Les deux contraintes coexistent car komgaConfigId et stripstreamConfigId
  // sont mutuellement exclusifs (l'un nul si l'autre est défini).
  @@unique([userId, komgaConfigId, seriesId])
  @@unique([userId, stripstreamConfigId, seriesId])
  @@index([userId])
  @@map("favorites")
}

// L'avancement appartient au compte Stripstream, pas au compte technique du
// fournisseur (Komga ou Stripstream). Deux utilisateurs peuvent donc partager
// une même bibliothèque sans partager leurs lectures.
model ReadProgress {
  id         Int      @id @default(autoincrement())
  userId     Int
  bookId     String
  page       Int?
  completed  Boolean  @default(false)
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@map("readprogresses")
}
